// Vistas previas en Cloudflare Workers (Workers Builds). La producción sigue en GitHub Pages (cauren.app).
{
  "name": "landing",
  "compatibility_date": "2026-11-01",
  // Sin estas URL el Worker queda en «No URLs enabled» y las vistas previas no tienen dónde publicarse.
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // Requerido por `wrangler preview`; vacío porque las vistas previas usan la configuración de arriba.
  "previews": {}
}
