---
import Simbolo from './Simbolo.astro';
import EjemploIndicadores from './EjemploIndicadores.astro';
import EjemploAsignaciones from './EjemploAsignaciones.astro';

// Dos mockups grandes sobre fondo Pino, con datos ficticios del mismo universo que el resto de la página.
const piezas = [
  {
    mockup: EjemploIndicadores,
    titulo: 'Tu resumen de cobros',
    descripcion: 'Lo que falta cobrar, lo que ya cobraste y lo que todavía no asignaste.',
  },
  {
    mockup: EjemploAsignaciones,
    titulo: 'Las transferencias y el efectivo, juntos',
    descripcion: 'Cada pago con la persona y la cuota a la que corresponde.',
  },
];
---

<section id="demo" aria-labelledby="demo-titulo" class="fondo-pino bg-pino">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24">
    <div class="flex items-start justify-between gap-6">
      <div>
        <p class="antetitulo-sobre-pino">Así la estamos diseñando</p>
        <h2 id="demo-titulo" class="mt-3 max-w-2xl text-3xl font-bold tracking-tight text-white sm:text-4xl">
          Todo en un lugar. Todo explicado.
        </h2>
      </div>
      <div class="logo-animado logo-scroll hidden shrink-0 opacity-30 transition-opacity duration-300 hover:opacity-70 sm:block">
        <Simbolo version="negativa" class="h-16 w-16" />
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-10 sm:gap-14">
      {piezas.map(({ titulo, descripcion, mockup: Mockup }) => (
        <div class="revelar">
          <div class="mb-4">
            <p class="m-0 text-xl font-semibold text-white">{titulo}</p>
            <p class="m-0 mt-1 text-base text-texto-sobre-pino-secundario">{descripcion}</p>
          </div>
          <div class="escala-hover">
            <Mockup />
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
