---
import Simbolo from './Simbolo.astro';

// Dos recortes grandes del prototipo de diseño sobre fondo Pino.
const capturas = [
  {
    src: '/app/indicadores.png',
    ancho: 1112,
    alto: 139,
    alt: 'Resumen de Cauren con tres indicadores: lo que falta cobrar, lo cobrado en el mes y los pagos que esperan tu confirmación.',
    titulo: 'Tu resumen diario',
    descripcion: 'Lo que falta cobrar, lo que ya cobraste y lo que espera tu confirmación.',
  },
  {
    src: '/app/cobros-conciliados.png',
    ancho: 1112,
    alto: 325,
    alt: 'Cobros asignados en Cauren: cada transferencia de Mercado Pago o cobro en efectivo con el pasajero y la cuota a la que se asignó.',
    titulo: 'Todo lo que entra, junto',
    descripcion: 'Transferencias de Mercado Pago y efectivo, cada pago con la persona y la cuota a la que corresponde.',
  },
];
---

<section id="demo" aria-labelledby="demo-titulo" class="scroll-mt-20 bg-pino">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24">
    <div class="flex items-start justify-between gap-6">
      <div>
        <p class="text-xs font-semibold tracking-[0.2em] text-salvia uppercase">Así la estamos diseñando</p>
        <h2 id="demo-titulo" class="mt-3 max-w-2xl text-3xl font-bold tracking-tight text-white sm:text-4xl">
          Todo en un lugar. Todo explicado.
        </h2>
      </div>
      <div class="logo-animado logo-scroll hidden shrink-0 opacity-30 transition-opacity duration-300 hover:opacity-70 sm:block">
        <Simbolo version="negativa" class="h-16 w-16" />
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-10 sm:gap-14">
      {capturas.map((captura) => (
        <figure class="revelar m-0">
          <figcaption class="mb-4">
            <p class="m-0 text-xl font-semibold text-white">{captura.titulo}</p>
            <p class="m-0 mt-1 text-base text-white/80">{captura.descripcion}</p>
          </figcaption>
          <div class="relative rounded-xl shadow-[0_24px_60px_-20px_rgba(0,0,0,0.5)] motion-safe:transition-transform motion-safe:duration-500 motion-safe:ease-out motion-safe:hover:z-10 motion-safe:hover:scale-[1.03]">
            <img
              src={captura.src}
              alt={captura.alt}
              width={captura.ancho}
              height={captura.alto}
              loading="lazy"
              decoding="async"
              class="revelar-zoom h-auto w-full rounded-xl"
            />
          </div>
        </figure>
      ))}
    </div>
    <p class="mt-8 text-sm text-white/70">Capturas del prototipo de diseño, con datos de ejemplo.</p>
  </div>
</section>
