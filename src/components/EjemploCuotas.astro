---
// Un viaje con dos pasajeros, cada uno con sus cuotas. Los datos son ficticios.
const ars = new Intl.NumberFormat('es-AR', { style: 'currency', currency: 'ARS' });
const $ = (n: number) => ars.format(n);

const personas = [
  {
    nombre: 'Thiago',
    cuotas: [
      { nombre: 'Cuota 1', vence: '13/09', importe: 50000, cubierto: 50000 },
      { nombre: 'Cuota 2', vence: '13/10', importe: 50000, cubierto: 10000 },
    ],
  },
  {
    nombre: 'Sofía',
    cuotas: [{ nombre: 'Cuota 1', vence: '13/09', importe: 70000, cubierto: 0 }],
  },
].map((p) => ({
  ...p,
  saldo: p.cuotas.reduce((suma, c) => suma + c.importe - c.cubierto, 0),
}));

const total = personas.reduce((suma, p) => suma + p.cuotas.reduce((s, c) => s + c.importe, 0), 0);
const saldo = personas.reduce((suma, p) => suma + p.saldo, 0);
---

<section id="ejemplo" aria-labelledby="ejemplo-titulo" class="scroll-mt-20 bg-white">
  <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-16 sm:px-6 sm:py-24 lg:grid-cols-2 lg:gap-16">
    <div class="revelar-izq">
      <p class="text-xs font-semibold tracking-[0.2em] text-bosque uppercase">Un ejemplo</p>
      <h2 id="ejemplo-titulo" class="mt-3 text-3xl font-bold tracking-tight text-pino sm:text-4xl">
        Cuentas claras con cada pasajero
      </h2>
      <p class="mt-6 max-w-lg text-lg leading-relaxed text-tinta/85">
        El viaje a Mar del Plata tiene dos pasajeros, cada uno con sus cuotas. Marcela, la mamá de Thiago, transfiere {$(60000)} y vos confirmás que es de Thiago.
      </p>
      <p class="mt-4 max-w-lg text-lg leading-relaxed text-tinta/85">
        Cauren lleva la cuenta: a Thiago se le completa la cuota 1 y le quedan {$(40000)} de la cuota 2. Lo de Sofía no se toca.
      </p>
    </div>

    <figure class="revelar-der m-0">
      <div class="rounded-3xl border border-salvia bg-niebla p-5 sm:p-6">
        <div class="flex items-baseline justify-between gap-3">
          <p class="m-0 text-sm font-semibold text-pino">Viaje a Mar del Plata · {$(total)}</p>
          <p class="m-0 text-sm text-tinta/75">Falta cobrar <strong class="text-pino">{$(saldo)}</strong></p>
        </div>

        {
          personas.map((persona) => (
            <div class="mt-5">
              <div class="flex items-baseline justify-between gap-3 border-b border-salvia pb-2">
                <h3 class="m-0 text-base font-semibold text-pino">{persona.nombre}</h3>
                <p class="m-0 text-sm text-tinta/75">
                  Le queda <strong class="text-pino">{$(persona.saldo)}</strong>
                </p>
              </div>
              <ul role="list" class="m-0 list-none p-0">
                {persona.cuotas.map((cuota) => (
                  <li class="flex flex-wrap items-center justify-between gap-x-3 gap-y-2 border-b border-salvia py-2 text-sm last:border-b-0">
                    <span class="text-tinta">
                      {cuota.nombre} <span class="text-tinta/70">· vence {cuota.vence}</span>
                    </span>
                    <span class="text-right">
                      <span class="block font-semibold whitespace-nowrap text-pino">{$(cuota.importe)}</span>
                      <span class="block text-xs text-tinta/75">
                        {cuota.cubierto === 0
                          ? 'Sin pagos'
                          : cuota.cubierto === cuota.importe
                            ? 'Pagada'
                            : `Pagó ${$(cuota.cubierto)}`}
                      </span>
                    </span>
                    <span class="block h-1.5 basis-full overflow-hidden rounded-full bg-salvia" aria-hidden="true">
                      <span class="barra block h-full rounded-full bg-brote" style={`width: ${(cuota.cubierto / cuota.importe) * 100}%`}></span>
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
      <figcaption class="mt-3 text-xs text-tinta/75">Ejemplo ilustrativo con datos ficticios.</figcaption>
    </figure>
  </div>

  <div class="mx-auto max-w-6xl px-4 pb-16 sm:px-6 sm:pb-24">
    <figure class="revelar m-0 max-w-3xl rounded-2xl border border-salvia bg-niebla p-6">
      <p class="m-0 text-xs font-semibold tracking-[0.14em] text-bosque uppercase">Otro ejemplo</p>
      <p class="m-0 mt-3 text-lg leading-relaxed text-tinta/85">
        Laura es psicóloga y le transfieren las sesiones del mes. Entran {$(30000)} de Jorge Paz, y Cauren le muestra que es la sesión de octubre de Ana: Jorge es quien paga por ella. Laura lo confirma y listo.
      </p>
      <figcaption class="mt-3 text-xs text-tinta/75">Ejemplo ilustrativo con datos ficticios.</figcaption>
    </figure>
  </div>
</section>
