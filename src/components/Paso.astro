---
interface Props {
  numero: number;
  titulo: string;
}

const { numero, titulo } = Astro.props;
---

<li class="flex flex-col gap-3 rounded-2xl border border-salvia bg-white p-6">
  <span class="flex h-10 w-10 items-center justify-center rounded-full bg-pino text-base font-bold text-white" aria-hidden="true">
    {numero}
  </span>
  <h3 class="text-lg font-semibold text-pino"><span class="sr-only">Paso {numero}: </span>{titulo}</h3>
  <div class="text-base leading-relaxed text-tinta/80 [&>p]:m-0">
    <slot />
  </div>
</li>
