---
import EjemploVenta from './EjemploVenta.astro';
import EjemploCobros from './EjemploCobros.astro';
import EjemploConciliacion from './EjemploConciliacion.astro';

// Sección "Cómo funciona": tres pasos, cada uno con su mockup HTML (datos ficticios, un solo universo).
const pasos = [
  {
    numero: 1,
    titulo: 'Anotá a quién le cobrás',
    descripcion: 'Cargás el viaje, la cuota o el servicio, a quién le cobrás y quién paga por cada uno. Si es en cuotas, también las fechas.',
    mockup: EjemploVenta,
  },
  {
    numero: 2,
    titulo: 'Conectá tu Mercado Pago',
    descripcion: 'Cauren ve las transferencias que entran a tu cuenta, vengan del banco o la billetera que sea. El efectivo lo anotás vos.',
    mockup: EjemploCobros,
  },
  {
    numero: 3,
    titulo: 'Confirmá de quién es cada pago',
    descripcion: 'Cauren te dice de quién cree que es cada transferencia y por qué. Vos lo confirmás, y sabés quién está al día y a quién le falta. Si no está seguro, te lo dice y lo asignás vos.',
    mockup: EjemploConciliacion,
  },
];
---

<section id="como-funciona" aria-labelledby="como-funciona-titulo" class="bg-niebla">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-16 sm:px-6 sm:py-24 lg:grid-cols-12 lg:gap-16">
    <div class="columna-fija lg:col-span-4 lg:self-start">
      <p class="antetitulo revelar">Cómo funciona</p>
      <h2 id="como-funciona-titulo" class="revelar mt-3 text-3xl font-bold tracking-tight text-pino sm:text-4xl">
        Tres pasos, y sabés de quién es cada pago
      </h2>
      <nav aria-label="Los tres pasos" class="mt-8">
        <ol role="list" class="m-0 grid list-none gap-1 p-0">
          {pasos.map((paso) => (
            <li>
              <a href={`#paso-${paso.numero}`} class="flex items-center gap-3 rounded-xl px-3 py-2 text-lg font-semibold text-pino transition-colors hover:bg-white">
                <span class="flex h-8 w-8 flex-none items-center justify-center rounded-full bg-pino text-sm font-bold text-white" aria-hidden="true">
                  {paso.numero}
                </span>
                {paso.titulo}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </div>

    <ol role="list" class="m-0 grid list-none gap-6 p-0 lg:col-span-8">
      {pasos.map(({ numero, titulo, descripcion, mockup: Mockup }) => (
        <li id={`paso-${numero}`} class="revelar min-w-0 rounded-3xl border border-salvia bg-white p-5 sm:p-8">
          <div class="flex items-start gap-5">
            <span class="flex h-10 w-10 flex-none items-center justify-center rounded-full bg-pino text-base font-bold text-white" aria-hidden="true">
              {numero}
            </span>
            <div class="min-w-0">
              <h3 class="m-0 text-2xl font-bold text-pino">
                <span class="sr-only">Paso {numero}: </span>{titulo}
              </h3>
              <p class="m-0 mt-2 max-w-lg text-lg leading-relaxed text-texto-cuerpo">
                {descripcion}
              </p>
            </div>
          </div>
          <div class="mt-6 flex items-center justify-center rounded-2xl bg-niebla p-3 sm:p-7">
            <div class="escala-hover w-full max-w-md">
              <Mockup />
            </div>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
