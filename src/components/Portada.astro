---
import EjemploConciliacion from './EjemploConciliacion.astro';

interface Props {
  antetitulo: string;
  titulo: string;
  correo: string;
}

const { antetitulo, titulo, correo } = Astro.props;
---

<section aria-labelledby="portada-titulo" class="bg-niebla">
  <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 py-16 sm:px-6 sm:py-24 lg:grid-cols-[1.1fr_1fr]">
    <div>
      <p class="text-xs font-semibold tracking-[0.2em] text-bosque uppercase">{antetitulo}</p>
      <h1 id="portada-titulo" class="mt-4 text-4xl leading-[1.1] font-bold tracking-tight text-pino sm:text-5xl lg:text-6xl">
        {titulo}
      </h1>
      <div class="mt-6 max-w-xl text-lg leading-relaxed text-tinta/85 sm:text-xl [&>p]:m-0">
        <slot />
      </div>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href={`mailto:${correo}`}
          class="rounded-full bg-pino px-6 py-3 text-base font-semibold text-white transition-colors hover:bg-bosque"
        >
          Escribinos
        </a>
        <a
          href="#como-funciona"
          class="rounded-full border border-pino/25 bg-white px-6 py-3 text-base font-semibold text-pino transition-colors hover:border-bosque hover:text-bosque"
        >
          Ver cómo funciona
        </a>
      </div>
    </div>
    <div class="flex justify-center lg:justify-end">
      <EjemploConciliacion />
    </div>
  </div>
</section>
