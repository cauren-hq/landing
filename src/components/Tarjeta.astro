---
interface Props {
  titulo: string;
}

const { titulo } = Astro.props;
---

<li class="flex flex-col gap-3 rounded-2xl border border-salvia bg-white p-6">
  <span class="h-1.5 w-10 rounded-full bg-brote" aria-hidden="true"></span>
  <h3 class="text-lg font-semibold text-pino">{titulo}</h3>
  <div class="text-base leading-relaxed text-tinta/80 [&>p]:m-0">
    <slot />
  </div>
</li>
