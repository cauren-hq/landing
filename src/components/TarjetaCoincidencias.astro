---
// Tarjeta de portada: dos coincidencias de ejemplo. Reemplaza la captura PNG, que decía «Confianza alta/media».
const ars = new Intl.NumberFormat('es-AR', { style: 'currency', currency: 'ARS' });

const coincidencias = [
  {
    origen: 'Mercado Pago · 5 nov',
    quien: 'Claudia Ríos',
    importe: 35000,
    para: 'Martina Ríos',
    detalle: 'Viaje a Mar del Plata · cuota 3',
    porque: ['Claudia está anotada como quien paga por Martina', 'El importe es el de la cuota'],
  },
  {
    origen: 'Mercado Pago · 3 nov',
    quien: 'Raúl Benítez',
    importe: 70000,
    para: 'Sofía Paredes',
    detalle: 'Viaje a Mar del Plata · cuota 1',
    porque: ['Raúl está anotado como quien paga por Sofía', 'El importe es el de la cuota'],
  },
];
---

<figure class="m-0">
  <div class="rounded-3xl border border-salvia bg-white p-5 shadow-alta sm:p-6">
    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
      <p class="m-0 text-lg font-bold text-pino">Coincidencias para revisar</p>
      <p class="m-0 text-sm text-texto-secundario">Nada se asigna sin tu confirmación</p>
    </div>
    <ul role="list" class="m-0 mt-4 grid list-none gap-3 p-0">
      {
        coincidencias.map((c, i) => (
          <li class="rounded-2xl border border-salvia p-4">
            <div class="grid grid-cols-[1fr_auto_1fr] items-center gap-3">
              <div class="min-w-0">
                <p class="m-0 text-sm text-texto-secundario">{c.origen}</p>
                <p class="m-0 mt-1 text-base font-semibold">{c.quien}</p>
                <p class="m-0 mt-1 text-xl font-bold whitespace-nowrap text-pino">{ars.format(c.importe)}</p>
              </div>
              <span class="text-xl text-texto-secundario" aria-hidden="true">→</span>
              <div class="min-w-0">
                <p class="m-0 text-sm text-texto-secundario">Sugerencia</p>
                <p class="m-0 mt-1 text-base font-semibold text-pino">{c.para}</p>
                <p class="m-0 mt-1 text-sm text-texto-secundario">{c.detalle}</p>
              </div>
            </div>
            <p id={`porque-${i}`} class="antetitulo m-0 mt-4" data-borrador>
              Por qué cree que es de {c.para.split(' ')[0]}
            </p>
            <ul role="list" aria-labelledby={`porque-${i}`} class="m-0 mt-2 flex list-none flex-wrap gap-2 p-0">
              {c.porque.map((texto) => (
                <li class="etiqueta-de-motivo">{texto}</li>
              ))}
            </ul>
            <div class="mt-4 flex justify-end gap-2" aria-hidden="true">
              <span class="pseudoboton">Revisar</span>
              <span class="pseudoboton">Confirmar</span>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
  <figcaption class="mt-3 text-xs text-texto-secundario">Ejemplo ilustrativo con datos ficticios. Los botones son ilustrativos.</figcaption>
</figure>
