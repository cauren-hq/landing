---
// Ilustración estática de una sugerencia de conciliación. Los datos son ficticios. Los importes
// siguen el formato de la interfaz de Cauren: «$ 80.000,00», con espacio de no separación.
const criterios = ['Referencia exacta', 'Importe exacto', 'Fecha cercana'];
---

<figure class="m-0 w-full max-w-md">
  <div class="rounded-3xl border border-salvia bg-white p-5 shadow-[0_24px_60px_-30px_rgba(14,59,42,0.45)] sm:p-6">
    <div class="flex items-center justify-between gap-3">
      <p class="m-0 text-sm font-semibold text-pino">Sugerencia de conciliación</p>
      <span class="inline-flex items-center gap-1.5 rounded-full bg-salvia px-3 py-1 text-xs font-semibold text-pino">
        <span class="h-2 w-2 rounded-full bg-brote" aria-hidden="true"></span>
        Confianza alta
      </span>
    </div>

    <dl class="mt-5 grid gap-3">
      <div class="rounded-2xl bg-niebla p-4">
        <dt class="text-xs font-semibold tracking-[0.14em] text-bosque uppercase">Esperado</dt>
        <dd class="m-0 mt-2 flex items-start justify-between gap-3">
          <span>
            <span class="block text-sm font-semibold text-tinta">Venta V-0142 · Cuota 3 de 6</span>
            <span class="block text-sm text-tinta/70">Vence el 10/10</span>
          </span>
          <span class="text-base font-bold whitespace-nowrap text-pino">$&nbsp;80.000,00</span>
        </dd>
      </div>
      <div class="rounded-2xl bg-niebla p-4">
        <dt class="text-xs font-semibold tracking-[0.14em] text-bosque uppercase">Ingresado</dt>
        <dd class="m-0 mt-2 flex items-start justify-between gap-3">
          <span>
            <span class="block text-sm font-semibold text-tinta">Transferencia · Mercado Pago</span>
            <span class="block text-sm text-tinta/70">08/10 · Ref. V-0142</span>
          </span>
          <span class="text-base font-bold whitespace-nowrap text-pino">$&nbsp;80.000,00</span>
        </dd>
      </div>
    </dl>

    <ul role="list" class="mt-4 flex list-none flex-wrap gap-2 p-0" aria-label="Criterios de la coincidencia">
      {
        criterios.map((criterio) => (
          <li class="rounded-full border border-salvia px-3 py-1 text-xs font-medium text-tinta/80">{criterio}</li>
        ))
      }
    </ul>

    <div class="mt-5 flex items-center justify-between gap-3 border-t border-salvia pt-4">
      <span class="text-sm text-tinta/70">Pendiente de tu confirmación</span>
      <span class="rounded-full bg-pino px-4 py-2 text-sm font-semibold text-white" aria-hidden="true">Confirmar</span>
    </div>
  </div>
  <figcaption class="mt-3 text-center text-xs text-tinta/75">Ejemplo ilustrativo con datos ficticios.</figcaption>
</figure>
