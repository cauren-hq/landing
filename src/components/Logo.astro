---
// Logotipo horizontal de deQuien: el símbolo (Simbolo.astro) y la palabra «deQuien» con los trazados del
// manual de marca («de» en Manrope Regular y «Quien» en Manrope Bold). Ambos comparten la retícula de 120
// unidades del símbolo, así que juntos reproducen el logotipo original sin redibujarlo.
import Simbolo from './Simbolo.astro';
import { PALABRA, PALABRA_VIEWBOX } from '../lib/marca.js';

interface Props {
  version?: 'positiva' | 'negativa';
  class?: string;
  animado?: boolean;
}

const { version = 'positiva', class: className = 'h-9', animado = false } = Astro.props;
const colorTexto = version === 'positiva' ? '#0E3B2A' : '#FFFFFF';
---

<span class:list={['logo inline-flex items-center', animado && 'logo-animado', className]}>
  <Simbolo version={version} class="h-full w-auto shrink-0" />
  <svg viewBox={PALABRA_VIEWBOX} class="h-full w-auto" role="img" aria-label="deQuien" focusable="false">
    <path fill={colorTexto} fill-rule="nonzero" d={PALABRA}></path>
  </svg>
</span>
