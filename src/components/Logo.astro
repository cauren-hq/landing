---
// Logotipo horizontal provisorio: símbolo original + «CAUREN» en Manrope. Se reemplaza por el
// archivo vectorial del logotipo cuando esté disponible.
import Simbolo from './Simbolo.astro';

interface Props {
  version?: 'positiva' | 'negativa';
  class?: string;
}

const { version = 'positiva', class: className } = Astro.props;
const colorTexto = version === 'positiva' ? 'text-pino' : 'text-white';
---

<span class:list={['inline-flex items-center gap-2.5', className]}>
  <Simbolo version={version} class="h-8 w-8 shrink-0" />
  <span class:list={['text-xl font-semibold tracking-[0.14em]', colorTexto]}>CAUREN</span>
</span>
