---
import Simbolo from './Simbolo.astro';

interface Props {
  titulo: string;
  correo: string;
}

const { titulo, correo } = Astro.props;
---

<section id="contacto" aria-labelledby="contacto-titulo" class="scroll-mt-20 bg-niebla">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24">
    <div class="relative overflow-hidden rounded-3xl bg-pino px-6 py-12 text-white sm:px-12 sm:py-16">
      <Simbolo version="negativa" class="pointer-events-none absolute -right-16 -bottom-16 h-72 w-72 opacity-10" />
      <h2 id="contacto-titulo" class="relative max-w-2xl text-3xl font-bold tracking-tight sm:text-4xl">{titulo}</h2>
      <div class="relative mt-4 max-w-2xl text-lg leading-relaxed text-white/85 [&>p]:m-0">
        <slot />
      </div>
      <a
        href={`mailto:${correo}`}
        class="relative mt-8 inline-flex rounded-full bg-white px-6 py-3 text-base font-semibold text-pino transition-colors hover:bg-salvia"
      >
        Escribinos a {correo}
      </a>
    </div>
  </div>
</section>
